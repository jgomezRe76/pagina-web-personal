---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5">
  <div
    class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-6 py-10 text-sm text-zinc-500 sm:flex-row sm:justify-between"
  >
    <p>&copy; {year} Jaime Gómez Recasens</p>
    <div class="flex items-center gap-5">
      <a
        href="https://www.linkedin.com/in/jaimegomezrecasens/"
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-zinc-200"
        aria-label="LinkedIn"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/jgomezRe76"
        target="_blank"
        rel="noreferrer"
        class="transition-colors hover:text-zinc-200"
        aria-label="GitHub"
      >
        GitHub
      </a>
      <a
        href="mailto:jaimegomezrecasens@gmail.com"
        class="transition-colors hover:text-zinc-200"
      >
        Contacto
      </a>
    </div>
  </div>
</footer>
